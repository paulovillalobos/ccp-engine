<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- D75: the daily refresh of ccp-engine on the Mac (Reader B reads through the Reader B app here). Not loaded by any tool:
     cp deploy/com.paulo.ccp-refresh.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.paulo.ccp-refresh.plist
     only on the person's word. Runs at 06:30 every day; logs in ~/Library/Logs/ccp-refresh.log. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.paulo.ccp-refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>cd ~/Downloads/ccp-engine &amp;&amp; .venv/bin/python -I tools/refresh.py --apply</string>
  </array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>30</integer></dict>
  <key>StandardOutPath</key><string>~/Library/Logs/ccp-refresh.log</string>
  <key>StandardErrorPath</key><string>~/Library/Logs/ccp-refresh.log</string>
</dict>
</plist>
