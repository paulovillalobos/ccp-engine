{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pacote.schema.json",
  "title": "Pacote de regras: the versioned set of rules for one law version",
  "description": "pacote:ccp@2026-10-01. hash = sha256 of the canonical JSON of rules (sorted by id). The package is the replay of the log's settled rules at log_head; verify refuses a package whose rules differ from the replay.",
  "type": "object",
  "allOf": [{"$ref": "defs.schema.json#/$defs/envelope"}],
  "properties": {
    "id": {"$ref": "defs.schema.json#/$defs/id_pacote"},
    "law_version": {"type": "string", "pattern": "^lei:[a-z0-9-]+@[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "rules": {"type": "array", "minItems": 1, "items": {"type": "object", "properties": {"id": {"$ref": "defs.schema.json#/$defs/id_regra"}, "revision": {"type": "integer", "minimum": 1}}, "required": ["id", "revision"], "additionalProperties": false}},
    "hash": {"$ref": "defs.schema.json#/$defs/sha256"},
    "log_head": {"$ref": "defs.schema.json#/$defs/sha256"},
    "built_at": {"$ref": "defs.schema.json#/$defs/datetime"}
  },
  "required": ["id", "revision", "recorded_at", "law_version", "rules", "hash", "log_head", "built_at"],
  "unevaluatedProperties": false
}
