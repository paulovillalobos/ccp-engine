{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "passagem.schema.json",
  "title": "Passagem: a passage of a norm, with its text per version",
  "description": "ccp:art113.2. One passage per structural node (artigo, número, alínea). Each version's text is located by offsets inside the captured raw text it was derived from, so verify can re-derive it (invariants 1 and 2). The law's clock lives here: valid_from / valid_to per version (invariant 8).",
  "type": "object",
  "allOf": [{"$ref": "defs.schema.json#/$defs/envelope"}],
  "properties": {
    "id": {"$ref": "defs.schema.json#/$defs/id_passagem"},
    "norma": {"$ref": "defs.schema.json#/$defs/id_norma"},
    "parent": {"oneOf": [{"$ref": "defs.schema.json#/$defs/id_passagem"}, {"type": "null"}]},
    "kind": {"type": "string", "enum": ["parte", "titulo", "capitulo", "secao", "artigo", "numero", "alinea", "subalinea", "epigrafe"]},
    "label": {"type": "string", "minLength": 1, "description": "As printed: Artigo 20.º, 1, a)"},
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "version": {"$ref": "defs.schema.json#/$defs/date", "description": "Equals valid_from; the key that citations name."},
          "text": {"type": "string", "minLength": 1},
          "raw": {"$ref": "defs.schema.json#/$defs/id_raw"},
          "offsets": {"$ref": "defs.schema.json#/$defs/offsets", "description": "Where text sits inside the raw capture's decoded text."},
          "valid_from": {"$ref": "defs.schema.json#/$defs/date"},
          "valid_to": {"oneOf": [{"$ref": "defs.schema.json#/$defs/date"}, {"type": "null"}], "description": "null: in force at the capture date."},
          "revoked": {"type": "boolean", "default": false}
        },
        "required": ["version", "text", "raw", "offsets", "valid_from", "valid_to"],
        "additionalProperties": false
      }
    }
  },
  "required": ["id", "revision", "recorded_at", "norma", "parent", "kind", "label", "versions"],
  "unevaluatedProperties": false
}
