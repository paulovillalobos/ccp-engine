    {
      "version": "2008-07-30",
      "text": "9 - As entidades adjudicantes devem comunicar à Comissão Europeia, a pedido desta, um relatório relativo aos contratos celebrados ao abrigo do disposto na alínea a) do n.º 1.",
      "raw": "raw:dr-consolidado:artigo-historico:ccp-art24-4",
      "offsets": {
        "start": 23681,
