            <table width="100%" border="0" cellspacing="0" cellpadding="0">
               <col width="4%"/>
               <col width="96%"/>
               <tbody>
                  <tr>
                     <td valign="top"  >
                        <p class="oj-normal">5.</p>
                     </td>
                     <td valign="top"  >
                        <p class="oj-normal">Código NUTS do local principal de prestação ou execução das concessões de serviços.</p>
