x; width: 100%;"></script></div></div><div data-container="" class="VerTodasAlteracoes texto" id="b18-l1-5862_1351-b7-b7-Alteracoes_Titulo"><a data-link="" href="#">Ver alterações ao texto</a></div></div></div></div></div><div data-container="" class="fragmento-separator"><div data-block="Utilities.Separator" class="OSBlockWidget" id="b18-l1-5862_1351-$b8"><div data-container="" class="padding-top-base padding-bottom-base"><div data-container="" class="separator separator-horizontal background-neutral-4 "></div></div></div></div></div><div data-container="" class="fragmento-full-width OSInline"><div data-block="LegislacaoConsolidada.FragmentoDetailTextoCompleto" class="OSBlockWidget" id="b18-l1-5862_1352-$b7"><div data-container="" class="Fragmento_Titulo" id="b18-l1-5862_1352-b7-C_Titulo"><span data-expression="" class="tituloletters">Artigo 1089.º</span></div><div data-container="" class="Fragmento_Epigrafe" id="b18-l1-5862_1352-b7-C_Epigrafe"><div data-block="HTMLInject.InjectHTML" class="OSBlockWidget" id="b18-l1-5862_1352-b7-$b2"><div data-container="" id="b18-l1-5862_1352-b7-b2-InjectHTMLWrapper">Caducidade</div></div></div><div data-block="LegislacaoConsolidada.EntradaEmVigor" class="OSBlockWidget" id="b18-l1-5862_1352-b7-$b3"></div><div data-container="" class="Fragmento_Texto diploma-fragmento int int-links"><div data-block="HTMLInject.InjectHTML" class="OSBlockWidget" id="b18-l1-5862_1352-b7-$b5"><div data-container="" id="b18-l1-5862_1352-b7-b5-InjectHTMLWrapper"><div>O subarrendamento caduca com a extinção, por qualquer causa, do contrato de arrendamento, sem prejuízo da responsabilidade do sublocador para com o sublocatário, quando o motivo da extinção lhe seja imputável.</div></div></div></div><div data-container="" class="alteracoesContainer" id="b18-l1-5862_1352-b7-Alteracoes"><div data-block="LegislacaoConsolidada.AlteracoesByFragmentoId" class="OSBlockWidget" id="b18-l1-5862_1352-b7-$b7"><div data-container="" class="VerTodasAlteracoesGeneralContai