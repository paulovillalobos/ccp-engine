                  <td valign="top" rowspan="1" colspan="1">
                     <p class="tbl-norm">Capítulo 95:</p>
                  </td>
                  <td valign="top" rowspan="1" colspan="1">
                     <p class="tbl-norm">Matérias para talhe ou modelação, preparadas ou em obra</p>
                  </td>
               </tr>
               <tr>
                  <td valign="top" rowspan="1" colspan="1">
                     <p class="tbl-norm">Capítulo 96:</p>
                  </td>
                  <td valign="top" rowspan="1" colspan="1">
                     <p class="tbl-norm">Escovas, pincéis e artefactos semelhantes, vassouras, borlas, peneiras e crivos</p>
                  </td>
               </tr>
               <tr>
                  <td valign="top" rowspan="1" colspan="1">
                     <p class="tbl-norm">Capítulo 98:</p>
                  </td>
                  <td valign="top" rowspan="1" colspan="1">
                     <p class="tbl-norm">Obras diversas</p>
                  </td>
               </tr>
            </tbody>
         </table>
      </div>
