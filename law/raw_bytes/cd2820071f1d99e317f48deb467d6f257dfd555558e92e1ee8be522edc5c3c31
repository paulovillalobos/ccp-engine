                  <col width="4%"/>
                  <col width="96%"/>
                  <tbody>
                     <tr>
                        <td valign="top"  >
                           <p class="oj-normal">i)</p>
                        </td>
                        <td valign="top"  >
                           <p class="oj-normal">As modalidades e características técnicas dos dispositivos de recepção electrónica referidas nas alíneas a), f) e g) do anexo X.</p>
                        </td>
                     </tr>
                  </tbody>
               </table>
