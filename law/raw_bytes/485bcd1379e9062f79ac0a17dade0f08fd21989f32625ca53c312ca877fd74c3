                           </tbody>
                        </table>
                        <table width="100%" border="0" cellspacing="0" cellpadding="0">
                           <col width="4%"/>
                           <col width="96%"/>
                           <tbody>
                              <tr>
                                 <td valign="top"  >
                                    <p class="oj-normal">d)</p>
                                 </td>
                                 <td valign="top"  >
                                    <p class="oj-normal">Indicar se as pessoas coletivas devem referir os nomes e as habilitações profissionais do pessoal responsável pela execução dos serviços;</p>
                                 </td>
                              </tr>
                           </tbody>
                        </table>
